{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mrr/schemas/correction-notification.schema.json",
  "title": "MRR CorrectionNotification",
  "type": "object",
  "required": [
    "notification_id",
    "correction_id",
    "correction_revision",
    "notifying_practice_id",
    "recipient_practice_id",
    "notified_object_ids",
    "correction_type",
    "severity",
    "reason",
    "requested_action",
    "content_hash",
    "nonce",
    "sent_at",
    "expires_at",
    "signature"
  ],
  "properties": {
    "notification_id": {"$ref": "common.schema.json#/$defs/urn"},
    "correction_id": {"$ref": "common.schema.json#/$defs/urn"},
    "correction_revision": {"type": "integer", "minimum": 1},
    "notifying_practice_id": {"$ref": "common.schema.json#/$defs/urn"},
    "recipient_practice_id": {"$ref": "common.schema.json#/$defs/urn"},
    "notified_object_ids": {
      "description": "task-packets/E9-T00.yaml item 2 (derived_decisions (e)): maxItems 512 is the first array-length bound in this repository, sized against the concrete DoS-relevant cost it caps — CorrectionImpactService._gather_local_impact_edges seeds its BFS directly from this attacker-influenced (notifying-practice-controlled) list, issuing one EdgeRepository.edges_to() query per unique seed id, so an unbounded list alone could force an unbounded number of seed-level queries before any further graph expansion. 512 is a generous ceiling for the legitimate case (one notification's own directly-affected ids for ONE recipient) while still capping the attacker-controlled input to a fixed, reviewable number.",
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "common.schema.json#/$defs/urn"}
    },
    "correction_type": {
      "type": "string",
      "enum": ["metadata", "source_invalidated", "numeric_error", "method_error", "scope_error", "consent_change", "data_withdrawal", "security", "other"]
    },
    "severity": {"type": "string", "enum": ["minor", "material", "critical"]},
    "reason": {"type": "string", "minLength": 1},
    "requested_action": {"type": "string"},
    "replacement_object_id": {"anyOf": [{"$ref": "common.schema.json#/$defs/urn"}, {"type": "null"}]},
    "content_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "nonce": {"type": "string", "minLength": 16},
    "sent_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "signature": {"$ref": "common.schema.json#/$defs/signature"}
  },
  "additionalProperties": false
}
